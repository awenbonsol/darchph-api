# Darch PH API — environment configuration
# Copy to .env and fill in real values. Never commit real secrets.

# Database (Supabase Postgres)
DATABASE_URL=jdbc:postgresql://<host>:5432/postgres
DB_USER=postgres
DB_PASSWORD=change-me

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=14400

# Supabase Storage (service-role key, server-only)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# CORS
CORS_ALLOWED_ORIGINS=https://darchph.vercel.app,http://localhost:5173

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-16-chars
